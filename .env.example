# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=dropday

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Enable only after /auth-runtime is deployed and registered as the Clerk proxy URL.
NEXT_PUBLIC_CLERK_PROXY_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Ably
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_ENABLED=false

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM=Dropday <drops@example.com>

# Browser push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
